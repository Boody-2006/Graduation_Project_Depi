@model LoginViewModel

@{
    ViewData["Title"] = "Log In / تسجيل الدخول";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-6 col-lg-5">
        <div class="auth-card">
            <div class="auth-header primary-theme">
                <div class="auth-icon-circle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                    </svg>
                </div>
                <h4 class="auth-title">Welcome Back / مرحباً بعودتك</h4>
                <div class="auth-subtitle">Sign in to your MediCare account</div>
            </div>
            <div class="auth-body">

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm" role="alert">
                        <strong>Notice / تنبيه:</strong> @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label-custom"></label>
                        <input asp-for="Email" class="form-control form-control-custom" placeholder="name@example.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label-custom"></label>
                        <input asp-for="Password" class="form-control form-control-custom" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted"></label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-auth-primary">
                            Log In / تسجيل الدخول
                        </button>
                    </div>
                </form>

                <hr class="my-4 text-muted opacity-25" />

                <div class="text-center">
                    <p class="text-muted small mb-2">New to MediCare? / ليس لديك حساب بعد؟</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="RegisterPatient" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                            Register as Patient / كمريض
                        </a>
                        <a asp-action="RegisterDoctor" class="btn btn-outline-success btn-sm rounded-pill px-3">
                            Register as Doctor / كطبيب
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
