
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCare</title>

    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/medicare.css" asp-append-version="true" />
</head>
<body>
    <header class="hd">
        <a class="lg" asp-controller="Home" asp-action="Index">
            MediCare
        </a>

        <nav class="nv">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Doctors" asp-action="Index">Doctors</a>
        </nav>

        <div>
            <a class="sm" asp-controller="Account" asp-action="Login">Sign in</a>
            <a class="pb" asp-controller="Account" asp-action="Register">Register</a>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="ft">
        <div class="wrap fg">
            <div>
                <div class="lg">MediCare</div>
                <p class="mu">Care that keeps its appointments</p>
            </div>

            <div class="mu">
                &copy; 2026 MediCare. All rights reserved.
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
