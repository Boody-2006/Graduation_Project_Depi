@*
    _Layout.cshtml
    The shared frame (master page) of every page: header, footer and the CSS/fonts.
    Each View is placed inside @RenderBody(), and sets its own title with ViewData["Title"].
*@
@{
    // Which controller is open? Used to highlight the active link in the navbar.
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - MediCare</title>

    @* Fonts: Fraunces for headings, IBM Plex Sans for body text *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />

    @* medicare.css = base styles, medicare-pro.css = the professional design layer (must come second).
       asp-append-version stops the browser from showing an old cached copy after a change. *@
    @* Person 5's login/register/booking/admin pages use Bootstrap classes (row, col-*, form-control, alert...).
       So Bootstrap is loaded on Account, Booking, and Admin pages; every other page uses our own design. *@
    @if (current is "Account" or "Booking" or "Admin")
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }

    @* site.css comes from the team (Person 5's login/register styles); it is loaded FIRST so our design can override it *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/medicare.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/medicare-pro.css" asp-append-version="true" />

    <script>
        // If any image fails to load, hide it so the fallback behind it (colour or initial)
        // is shown instead of a broken-image icon. One handler for the whole site.
        document.addEventListener("error", function (e) {
            var el = Object(e.target);
            if (el.tagName === "IMG") { el.style.display = "none"; }
        }, true);

        // Close the Register dropdown when the user clicks anywhere outside it.
        document.addEventListener("click", function (e) {
            document.querySelectorAll("details.dd[open]").forEach(function (d) {
                if (!d.contains(Object(e.target))) { d.removeAttribute("open"); }
            });
        });
    </script>
</head>
<body class="@(current is "Account" or "Booking" or "Admin" ? "page-account" : "")">

    @* ===== Header ===== *@
    <header class="hd">
        <div class="wrap hd-in">
            <a class="lg" asp-controller="Home" asp-action="Index">
                <svg width="30" height="30" viewBox="0 0 28 28" aria-hidden="true">
                    <circle cx="11" cy="14" r="9" fill="currentColor" opacity=".35" />
                    <circle cx="17" cy="14" r="9" fill="currentColor" />
                </svg>
                MediCare
            </a>

            <nav class="nv">
                <a class="@(current == "Home" ? "on" : "")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="@(current == "Doctors" ? "on" : "")" asp-controller="Doctors" asp-action="Index">Doctors</a>
                @if (User.IsInRole("Patient"))
                {
                    <a class="@(current == "Booking" && action == "Index" ? "on" : "")" asp-controller="Booking" asp-action="Index">Book Appointment</a>
                    <a class="@(current == "Booking" && action == "MyAppointments" ? "on" : "")" asp-controller="Booking" asp-action="MyAppointments">My Appointments</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a class="@(current == "Admin" ? "on" : "")" asp-controller="Admin" asp-action="PendingDoctors">Approve Doctors</a>
                }
            </nav>

            @* Sign in / Register (or the user name + Logout when logged in) comes from Person 5's partial *@
            <partial name="_LoginPartial" />
        </div>
    </header>

    @* ===== Page content ===== *@
    <main class="@(current is "Account" or "Booking" or "Admin" ? "container py-4" : "")">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    @* ===== Footer ===== *@
    <footer class="ft">
        <div class="wrap">
            <div class="ft-grid">
                <div>
                    <div class="lg">
                        <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
                            <circle cx="11" cy="14" r="9" fill="currentColor" opacity=".35" />
                            <circle cx="17" cy="14" r="9" fill="currentColor" />
                        </svg>
                        MediCare
                    </div>
                    <p class="mu" style="max-width:34ch;margin:0">Care that keeps its appointments. Find a specialist, book online and keep your records in one place.</p>
                </div>
                <div>
                    <h4>Explore</h4>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Doctors" asp-action="Index">Find a doctor</a>
                </div>
                <div>
                    <h4>Account</h4>
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                    <a asp-controller="Account" asp-action="RegisterPatient">Register</a>
                </div>
            </div>
            <div class="ft-bot">
                <span>&copy; 2026 MediCare. All rights reserved.</span>
                <span>Graduation project - DEPI</span>
            </div>
        </div>
    </footer>

    @* jQuery + Bootstrap JS on Account, Booking, and Admin pages (form validation, dismissible alerts, modals) *@
    @if (current is "Account" or "Booking" or "Admin")
    {
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    }

    @* Optional place for page-specific scripts *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
